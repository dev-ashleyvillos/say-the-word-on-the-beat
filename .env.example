# Which docker-compose override `npm run docker:up` picks: development or production
ENV=development

# Admin dashboard password (Bearer token). Dev defaults to "admin" if unset;
# production has no default — it MUST be set or the API will run with a blank password.
ADMIN_PASSWORD=admin

# MongoDB Express Admin Interface Credentials
# Copy this file to .env and change the values for production!
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=changeme123
